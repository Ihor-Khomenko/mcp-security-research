# Copy to .env and fill in the keys you need.
# Never commit .env.

# OpenAI
OPENAI_API_KEY=

# xAI Grok (https://api.x.ai/v1)
XAI_API_KEY=

# OpenRouter (free models use ids ending in :free)
OPENROUTER_API_KEY=

# Groq
GROQ_API_KEY=

# Anthropic (Claude API path in llm_client)
ANTHROPIC_API_KEY=

# Ollama OpenAI-compatible endpoint (optional; default key is "ollama")
OLLAMA_API_KEY=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional overrides for other providers
# OPENAI_BASE_URL=https://api.openai.com/v1
# XAI_BASE_URL=https://api.x.ai/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Rate limits (OpenRouter free tier ~50 req/day)
# LLM_MAX_REQUESTS=10
# LLM_REQUEST_DELAY=1.0
# LLM_MAX_RETRIES=5

# Optional external guard hook (MCP-Sentinel lives in LLM-tester-tool)
# GUARD_HOOK=none
# GUARD_HOOK=llm_tester.sentinel.adapters:MCPSentinelGuard

# Simulation defaults
# ATTACK_PROVIDER=ollama
# ATTACK_MODEL_CMD=qwen2.5:7b
# DEFEND_PROVIDER=openrouter
# DEFEND_MODEL_CMD=meta-llama/llama-3.2-3b-instruct:free
